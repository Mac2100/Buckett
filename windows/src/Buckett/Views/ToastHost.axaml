<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Buckett.Views"
             x:Class="Buckett.Views.ToastHost"
             IsHitTestVisible="False"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Margin="18">

  <ItemsControl x:Name="Host">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Classes="toast">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <views:Glyph Symbol="{Binding Symbol}" Size="16" VerticalAlignment="Center"
                         Foreground="{Binding BrushKey, Converter={x:Static views:Converters.BrushForKey}}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Message}" Classes="callout" FontWeight="Medium" />
              <TextBlock Text="{Binding Detail}" Classes="caption secondary"
                         IsVisible="{Binding HasDetail}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
