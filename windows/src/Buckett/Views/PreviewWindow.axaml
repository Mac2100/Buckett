<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Buckett.Views"
        x:Class="Buckett.Views.PreviewWindow"
        Title="Preview"
        Width="820" Height="620"
        MinWidth="480" MinHeight="360"
        Icon="avares://Buckett/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SeparatorBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12">
        <views:Glyph Grid.Column="0" x:Name="HeaderGlyph" Size="18" VerticalAlignment="Center"
                     Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="NameLabel" Classes="headline" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DetailLabel" Classes="caption secondary"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" x:Name="OpenButton" Content="Open" Margin="8,0"
                IsVisible="False" Click="OnOpen" />
        <Button Grid.Column="3" Content="Done" IsCancel="True" Click="OnDone" />
      </Grid>
    </Border>

    <Panel>
      <StackPanel x:Name="LoadingBlock" Spacing="10" HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="180" />
        <TextBlock x:Name="LoadingLabel" Classes="secondary" HorizontalAlignment="Center" />
      </StackPanel>

      <ScrollViewer x:Name="ImageScroller" IsVisible="False">
        <Image x:Name="ImageView" Stretch="Uniform" Margin="12" />
      </ScrollViewer>

      <ScrollViewer x:Name="TextScroller" IsVisible="False">
        <TextBox x:Name="TextView" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" Classes="mono" FontSize="12.5"
                 BorderThickness="0" Background="Transparent" Margin="10" />
      </ScrollViewer>

      <StackPanel x:Name="GenericBlock" Spacing="12" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsVisible="False">
        <views:Glyph x:Name="GenericGlyph" Size="46" HorizontalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock x:Name="GenericTitle" Classes="title3" HorizontalAlignment="Center" />
        <TextBlock x:Name="GenericDetail" Classes="callout secondary" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" />
        <Button Classes="prominent" HorizontalAlignment="Center" Click="OnOpen"
                Content="Open with default app" />
      </StackPanel>

      <StackPanel x:Name="ErrorBlock" Spacing="8" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsVisible="False">
        <views:Glyph Symbol="exclamationmark.triangle" Size="34" HorizontalAlignment="Center"
                     Foreground="{DynamicResource WarningBrush}" />
        <TextBlock x:Name="ErrorLabel" Classes="secondary" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" />
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
