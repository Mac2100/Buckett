<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Buckett.Views"
             x:Class="Buckett.Views.MissingCredentialsView">

  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
    <views:Glyph Symbol="key.slash" Size="40" HorizontalAlignment="Center"
                 Foreground="{DynamicResource SecondaryTextBrush}" />
    <TextBlock Text="Missing credentials" Classes="title" HorizontalAlignment="Center" />
    <TextBlock Classes="secondary" TextAlignment="Center"
               Text="The secret access key for this account was not found in Windows Credential Manager.&#10;Re-enter it in Settings." />
    <Button HorizontalAlignment="Center" Click="OnOpenSettings">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <views:Glyph Symbol="gearshape" Size="15" />
        <TextBlock Text="Open Settings" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
