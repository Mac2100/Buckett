<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Buckett.Views"
        x:Class="Buckett.Views.MainWindow"
        Title="Buckett"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="620"
        Icon="avares://Buckett/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <Grid ColumnDefinitions="250,Auto,*">

      <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
        <views:SidebarView x:Name="Sidebar" />
      </Border>

      <GridSplitter Grid.Column="1" Width="1"
                    Background="{DynamicResource SeparatorBrush}"
                    ResizeDirection="Columns" />

      <ContentControl Grid.Column="2" x:Name="DetailHost" />
    </Grid>

    <!-- Overlays sit above the whole window, matching the SwiftUI overlays. -->
    <views:ToastHost x:Name="Toasts" />
    <views:UpdateOverlay x:Name="UpdateOverlayHost" />
  </Panel>

</Window>
