<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Buckett.Views"
        x:Class="Buckett.Views.SettingsWindow"
        Title="Buckett Settings"
        Width="820" Height="580"
        MinWidth="720" MinHeight="500"
        Icon="avares://Buckett/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

  <!-- Six sections down the side rather than across the top. Avalonia's default
       tab header is 24pt with heavy padding, so six tabs wrapped onto two rows
       and ate a third of the window before any setting appeared. A rail also
       leaves room for the section names to be read at a glance. -->

  <Grid ColumnDefinitions="188,Auto,*">

    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" Classes="title3"
                   Margin="18,16,18,10" />
        <ListBox x:Name="Nav" Classes="nav" Background="Transparent" BorderThickness="0"
                 Margin="8,0,8,10" SelectedIndex="0">
          <ListBoxItem Tag="Accounts">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="person.crop.circle" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Accounts" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Appearance">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="paintpalette" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Appearance" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="General">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="gearshape" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="General" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Notifications">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="bell.badge" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Notifications" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Updates">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="arrow.down.circle" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Updates" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="About">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <views:Glyph Symbol="info.circle" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="About" Classes="callout" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Width="1" Background="{DynamicResource SeparatorBrush}" />

    <Panel Grid.Column="2">
      <Grid ColumnDefinitions="172,Auto,*"
            x:Name="AccountsPage">
        <DockPanel Grid.Column="0">
          <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource SeparatorBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="6">
              <Button Classes="icon" Click="OnAddAccount" ToolTip.Tip="Add account">
                <views:Glyph Symbol="plus" Size="13" />
              </Button>
              <Button x:Name="RemoveAccountButton" Classes="icon" Click="OnRemoveAccount"
                      ToolTip.Tip="Remove account">
                <views:Glyph Symbol="minus" Size="13" />
              </Button>
            </StackPanel>
          </Border>
          <ListBox x:Name="AccountList" Classes="nav" Background="Transparent"
                   BorderThickness="0" Margin="6,6,6,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <views:Glyph Symbol="{Binding Symbol}" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource SeparatorBrush}" />

        <Panel Grid.Column="2">
          <StackPanel x:Name="NoAccountBlock" Spacing="8" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <views:Glyph Symbol="person.crop.circle.badge.questionmark" Size="36"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource TertiaryTextBrush}" />
            <TextBlock Text="Select an account, or add one with +" Classes="secondary" />
          </StackPanel>

          <ScrollViewer x:Name="EditorScroller" IsVisible="False">
            <StackPanel Margin="18" Spacing="14">

              <StackPanel Spacing="6">
                <TextBlock Text="Display Name" Classes="callout" FontWeight="Medium" />
                <TextBox x:Name="NameBox" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Provider" Classes="callout" FontWeight="Medium" />
                <Border Classes="segments" HorizontalAlignment="Left">
                  <StackPanel x:Name="ProviderHost" Orientation="Horizontal" Spacing="2" />
                </Border>
              </StackPanel>

              <TextBlock Text="Connection" Classes="caption secondary" FontWeight="SemiBold"
                         Margin="0,6,0,0" />
              <StackPanel Spacing="6">
                <TextBlock x:Name="RegionLabel" Classes="callout" FontWeight="Medium" />
                <TextBox x:Name="RegionBox" />
                <TextBlock x:Name="RegionHint" Classes="caption tertiary" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Custom Endpoint (optional)" Classes="callout"
                           FontWeight="Medium" />
                <TextBox x:Name="EndpointBox" />
                <TextBlock Text="Overrides the derived endpoint. Any S3-compatible endpoint works."
                           Classes="caption tertiary" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Endpoint" Classes="caption secondary" />
                <SelectableTextBlock x:Name="ResolvedEndpoint" Classes="caption mono secondary"
                                     TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Text="Credentials" Classes="caption secondary" FontWeight="SemiBold"
                         Margin="0,6,0,0" />
              <StackPanel Spacing="6">
                <TextBlock Text="Access Key ID" Classes="callout" FontWeight="Medium" />
                <TextBox x:Name="AccessKeyBox" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Secret Access Key" Classes="callout" FontWeight="Medium" />
                <TextBox x:Name="SecretKeyBox" PasswordChar="•" />
                <TextBlock Classes="caption tertiary" TextWrapping="Wrap"
                           Text="Credentials are stored only in Windows Credential Manager and are used solely to sign API requests sent directly to the provider." />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0" x:Name="TestButton" Content="Test Connection"
                        Click="OnTestConnection" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                            Margin="12,0" VerticalAlignment="Center">
                  <ProgressBar x:Name="TestSpinner" IsIndeterminate="True" Width="40" Height="3"
                               VerticalAlignment="Center" IsVisible="False" />
                  <views:Glyph x:Name="TestGlyph" Size="14" VerticalAlignment="Center"
                               IsVisible="False" />
                  <TextBlock x:Name="TestLabel" Classes="caption" VerticalAlignment="Center"
                             TextWrapping="Wrap" MaxWidth="220" />
                </StackPanel>
                <Button Grid.Column="2" Classes="prominent" Content="Save" Click="OnSaveAccount" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Grid>
      <ScrollViewer
                 x:Name="AppearancePage"
                 IsVisible="False">
        <StackPanel Margin="20" Spacing="18">
          <StackPanel Spacing="8">
            <TextBlock Text="Appearance" Classes="callout" FontWeight="Medium" />
            <Border Classes="segments" HorizontalAlignment="Left">
              <StackPanel x:Name="AppearanceHost" Orientation="Horizontal" Spacing="2" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Theme" Classes="callout" FontWeight="Medium" />
            <!-- Six themes read best as two rows of three. -->
            <ItemsControl x:Name="ThemeHost" MaxWidth="352" HorizontalAlignment="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="plain" Margin="0,0,10,10" Padding="0" Width="104"
                          Click="OnPickTheme">
                    <Border CornerRadius="10" Padding="10" Background="{Binding Background}"
                            BorderBrush="{Binding Border}" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <Border Width="38" Height="38" CornerRadius="19"
                                Background="{Binding Swatch}" HorizontalAlignment="Center">
                          <views:Glyph Symbol="checkmark" Size="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSelected}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Classes="callout"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Notification Area Icon" Classes="callout" FontWeight="Medium" />
            <ItemsControl x:Name="TrayIconHost">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="plain" Margin="0,0,10,10" Padding="0" Width="84"
                          Click="OnPickTrayIcon">
                    <Border CornerRadius="9" Padding="9" Background="{Binding Background}"
                            BorderBrush="{Binding Border}" BorderThickness="1">
                      <StackPanel Spacing="6">
                        <views:Glyph Symbol="{Binding Symbol}" Size="20"
                                     HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Classes="caption2"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption tertiary" TextWrapping="Wrap"
                       Text="Shown in the notification area, next to the clock." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer
                 x:Name="GeneralPage"
                 IsVisible="False">
        <StackPanel Margin="20" Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Default view" Classes="callout"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="DefaultViewPicker" MinWidth="140" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Concurrent transfers" Classes="callout"
                       VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" x:Name="ConcurrencyStepper" Minimum="1" Maximum="8"
                           Increment="1" FormatString="0" Width="130" />
          </Grid>

          <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                     Text="Uploads of 16 MB or more automatically use resumable multipart uploads. Interrupted uploads resume from the last completed part when retried." />

          <Border Classes="separator" />

          <StackPanel Spacing="8">
            <CheckBox x:Name="TrayIconToggle" Content="Show notification-area icon" />
            <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                       Text="Keeps Buckett running after you close the window, and carries its notifications. With this off, closing the window quits the app." />
          </StackPanel>

          <Border Classes="separator" />

          <StackPanel Spacing="8">
            <CheckBox x:Name="OpenAtLoginToggle" Content="Open at login" />
            <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                       Text="Starts Buckett automatically when you sign in to Windows." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer
                 x:Name="NotificationsPage"
                 IsVisible="False">
        <StackPanel Margin="20" Spacing="14">
          <TextBlock Text="System Notifications" Classes="caption secondary"
                     FontWeight="SemiBold" />
          <CheckBox x:Name="NotifyCompleteToggle" Content="All transfers finished" />
          <CheckBox x:Name="NotifyFailedToggle" Content="A transfer fails" />
          <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                     Text="Delivered through the notification-area icon, so Windows shows them in the Action Center. They are suppressed while the icon is hidden." />

          <Border Classes="separator" />

          <TextBlock Text="In-App" Classes="caption secondary" FontWeight="SemiBold" />
          <CheckBox x:Name="ToastsToggle" Content="Show toast banners" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer
                 x:Name="UpdatesPage"
                 IsVisible="False">
        <StackPanel Margin="20" Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Current version" Classes="callout"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="VersionLabel" Classes="callout secondary"
                       VerticalAlignment="Center" />
          </Grid>

          <CheckBox x:Name="AutoCheckToggle" Content="Check for updates at launch" />

          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" x:Name="CheckNowButton" Content="Check Now"
                    Click="OnCheckUpdates" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0"
                        VerticalAlignment="Center">
              <ProgressBar x:Name="CheckSpinner" IsIndeterminate="True" Width="40" Height="3"
                           VerticalAlignment="Center" IsVisible="False" />
              <views:Glyph x:Name="UpdateGlyph" Size="14" VerticalAlignment="Center"
                           IsVisible="False" />
              <TextBlock x:Name="UpdateStatusLabel" Classes="caption" TextWrapping="Wrap"
                         VerticalAlignment="Center" MaxWidth="330" />
            </StackPanel>
          </Grid>

          <Button x:Name="InstallButton" Classes="prominent" Content="Install &amp; Relaunch"
                  HorizontalAlignment="Left" IsVisible="False" Click="OnInstallUpdate" />

          <TextBlock x:Name="UpdaterPhaseLabel" Classes="caption secondary" IsVisible="False" />
          <TextBlock x:Name="LastCheckedLabel" Classes="caption tertiary" />

          <Button Classes="link" Content="View releases on GitHub" HorizontalAlignment="Left"
                  Click="OnOpenReleases" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                 x:Name="AboutPage"
                 IsVisible="False">
        <views:AppGlyph GlyphSize="64" HorizontalAlignment="Center" />
        <TextBlock Text="Buckett" Classes="title" HorizontalAlignment="Center" />
        <TextBlock x:Name="AboutVersion" Classes="secondary" HorizontalAlignment="Center" />
        <TextBlock Classes="callout secondary" TextAlignment="Center"
                   Text="An open-source visual bucket explorer for&#10;Cloudflare R2 and Backblaze B2." />
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
          <Button Classes="link" Content="GitHub" Click="OnOpenRepo" />
          <Button Classes="link" Content="Releases" Click="OnOpenReleases" />
          <Button Classes="link" Content="MIT License" Click="OnOpenLicense" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                    Margin="0,8,0,0">
          <Button Classes="plain" Click="OnBuyCoffee">
            <Border Background="#FFDD00" CornerRadius="18" Padding="16,9">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <views:Glyph Symbol="cup.and.saucer.fill" Size="15" Foreground="Black"
                             VerticalAlignment="Center" />
                <TextBlock Text="Buy Me a Coffee" Foreground="Black" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
          <Button Classes="plain" Click="OnOpenRepo">
            <Border Background="{DynamicResource QuaternaryFillBrush}" CornerRadius="18"
                    Padding="16,9" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <views:Glyph Symbol="star.fill" Size="15" VerticalAlignment="Center" />
                <TextBlock Text="Star on GitHub" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
        </StackPanel>
      </StackPanel>
    </Panel>

  </Grid>
</Window>
