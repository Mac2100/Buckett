<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Buckett.Views">

  <!-- Typography helpers, named after the SwiftUI text styles they stand in for. -->
  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.largeTitle">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.callout">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.caption2">
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
  </Style>
  <Style Selector="TextBlock.digits">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- Cards: the stand-in for SwiftUI's .glassCard() modifier. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 3 8 0 #14000000" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.prominent">
    <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.prominent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="Opacity" Value="0.88" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentTextBrush}" />
  </Style>
  <Style Selector="Button.prominent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentTextBrush}" />
  </Style>
  <Style Selector="Button.prominent:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.destructive">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Opacity" Value="0.88" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Chromeless button: the .buttonStyle(.plain) analog. -->
  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.plain /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.plain:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Small icon button used in toolbars and rows. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFillBrush}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Text fields -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
  </Style>

  <!-- Sheet chrome: modal dialogs are hosted in their own borderless window. -->
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="views|Glyph">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!-- Capsule segmented control: the detail tabs and the grid/list toggle. -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource QuaternaryFillBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="ToggleButton.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FaintFillBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!-- Floating action bar shown while objects are selected. -->
  <Style Selector="Border.floatingBar">
    <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #26000000" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #22000000" />
  </Style>

  <!-- Selectable row cards (sidebar buckets). -->
  <Style Selector="Border.rowCard">
    <Setter Property="Background" Value="{DynamicResource FaintFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.rowCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverFillBrush}" />
  </Style>
  <Style Selector="Border.rowCard.selected">
    <Setter Property="Background" Value="{DynamicResource ThemePrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryEdgeBrush}" />
  </Style>

  <!-- Settings navigation rail: quiet rows that pick up the accent when
       selected, rather than Fluent's full-bleed highlight bar. -->
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFillBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemePrimarySoftBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Grid tiles in the object browser. -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 2 4 0 #14000000" />
  </Style>
  <Style Selector="Border.tile:pointerover">
    <Setter Property="BoxShadow" Value="0 2 8 0 #1F000000" />
  </Style>
  <Style Selector="Border.tile.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{DynamicResource QuaternaryFillBrush}" />
  </Style>

  <!-- Search field: rounded, with a leading glyph. -->
  <Style Selector="Border.searchField">
    <Setter Property="Background" Value="{DynamicResource QuaternaryFillBrush}" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="9,3" />
  </Style>
  <Style Selector="Border.searchField TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="Border.searchField TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
  </Style>

</Styles>
